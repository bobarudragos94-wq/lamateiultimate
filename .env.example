# Turso / libSQL database. Leave TURSO_DATABASE_URL empty to use a local SQLite file (file:local.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Secret used to sign auth session tokens (generate with: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the app (used in metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000
